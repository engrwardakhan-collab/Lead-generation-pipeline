# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
LEADS_TABLE=leads                        # optional, default: leads

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by: WebsiteEnricher (contact page email extraction), personalization agent, reply classifier
OPENAI_API_KEY=sk-proj-your_key_here

# ── Scraper settings (all optional — these are the defaults) ──────────────────
SCRAPER_HEADLESS=false                   # true for unattended/production runs
SCRAPER_MAX_PAGES=3                      # listing pages per city (~20 agents/page)
SCRAPER_DELAY_MIN=2.0                    # seconds between page loads
SCRAPER_DELAY_MAX=5.0

# ── Enricher settings (all optional) ─────────────────────────────────────────
ENRICHER_MAX_PER_RUN=50                  # max leads to enrich per run
ENRICHER_DELAY_SECONDS=3.0              # seconds between enrichment attempts
ENRICHER_MIN_LISTINGS=5                 # min listing count for --high-value filter

# ── Email — Brevo SMTP ────────────────────────────────────────────────────────
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_login       # found in Brevo → SMTP & API → SMTP tab
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=warda.khan@convertwithai.tech
BREVO_SENDER_NAME=Warda Khan


# ── Webhook — systeme.io ──────────────────────────────────────────────────────
SYSTEME_IO_WEBHOOK_URL=https://systeme.io/your-webhook-url

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
